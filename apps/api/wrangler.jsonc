{
  // Niko: one Worker serves the API and the three front ends on both domains.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "niko",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none", "html_handling": "none" },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // Answer only on the custom domains below, never on *.workers.dev or preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "niko.sxingxian.com", "custom_domain": true },
    { "pattern": "niko.midnightpoetry.studio", "custom_domain": true },
    { "pattern": "nikoapp.midnightpoetry.studio", "custom_domain": true }
  ],
  "vars": {
    "EMAIL_FROM": "Niko <niko-noreply@app.midnightpoetry.studio>",
    // Tried in order; the second is used only if the first fails (for example after Cloudflare retires a model).
    // Check https://developers.cloudflare.com/workers-ai/models/ for retirement dates before changing.
    "AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct,@cf/mistralai/mistral-small-3.1-24b-instruct"
  }
  // Secrets (set with `wrangler secret put NAME`, never committed):
  // DATABASE_URL, ENCRYPTION_KEY, BOOTSTRAP_TOKEN, RESEND_API_KEY
  // Google, Microsoft, Notion and Slack keys are NOT set here: each account saves its own on the Connections screen.
}
