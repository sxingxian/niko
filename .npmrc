# onnxruntime-node (pulled in by @huggingface/transformers) downloads optional GPU (CUDA) binaries on Linux during
# install. Niko never runs models with CUDA on a server, and that download has started returning 404, which fails
# `npm ci` and so every deploy. Skip it; on-device voice runs in the browser and is unaffected.
onnxruntime-node-install-cuda=skip
